+# =====================================================================================
+# Per-episode paraphrase eval with action+EEF logging.
+# Triggered via env vars EPISODES_JSON, EPISODES_OUTPUT_DIR, EPISODES_START_IDX,
+# EPISODES_END_IDX. Designed for single-task length-1 sequences.
+# =====================================================================================
+
+def _rollout_episode_logged(env, model, task_oracle, init_state_dict, lang_annotation, task_id):
+    """Run one length-1 rollout, capturing per-step actions + eef_xyz.
+    Returns (success, num_steps, actions_list, eef_xyz_list).
+    """
+    robot_obs, scene_obs = get_env_state_for_initial_condition(init_state_dict)
+    env.reset(robot_obs=robot_obs, scene_obs=scene_obs)
+    obs = env.get_obs()
+
+    if '’' in lang_annotation:
+        lang_annotation = lang_annotation.replace('’', "'")
+
+    model.reset()
+    start_info = env.get_info()
+
+    actions_log = []
+    eef_log = []
+    planned_actions = []
+
+    for step in range(EP_LEN):
+        if model.replan != -1 and step % model.replan == 0:
+            if model.model.module.refresh != -1:
+                model.model.module.lang_encoder.lm_head.hidden_state = None
+                model.model.module.lang_encoder.lm_head.history_memory = (
+                    model.model.module.lang_encoder.lm_head.history_memory[-model.refresh:]
+                )
+            else:
+                model.reset()
+        action = model.step(obs, lang_annotation, (len(planned_actions) == 0))
+        if len(planned_actions) == 0:
+            if action.shape == (7,):
+                planned_actions.append(action)
+            else:
+                planned_actions.extend([action[i] for i in range(action.shape[0])])
+        action = planned_actions.pop(0)
+        if model.use_diff:
+            model.action_hist_queue.append(action)
+
+        # log action BEFORE stepping (predicted action)
+        try:
+            actions_log.append(np.asarray(action, dtype=float).reshape(-1).tolist())
+        except Exception:
+            actions_log.append(None)
+
+        obs, _, _, current_info = env.step(action)
+
+        # log EEF position from robot_obs[:3]
+        try:
+            ro = obs['robot_obs']
+            if isinstance(ro, dict):
+                eef = ro.get('tcp_pos') or ro.get('robot_state_full', [None, None, None])[:3]
+            else:
+                eef = np.asarray(ro)[:3]
+            eef_log.append(np.asarray(eef, dtype=float).tolist())
+        except Exception as _e:
+            if step == 0:
+                print(f"[RF eef capture] failed: {_e}, obs keys: {list(obs.keys()) if hasattr(obs,'keys') else type(obs)}")
+            eef_log.append(None)
+
+        current_task_info = task_oracle.get_task_info_for_set(start_info, current_info, {task_id})
+        if len(current_task_info) > 0:
+            return True, step + 1, actions_log, eef_log
+
+    return False, EP_LEN, actions_log, eef_log
+
+
+def evaluate_policy_episodes(model, env, calvin_conf_path):
+    """Run an episode list (paraphrase or baseline). Each episode JSON entry has:
+        episode_idx, init_state, task_id, lang_override, metadata
+    Output: <output_dir>/eval_<task_id>.json (one file per task, list of episodes).
+    """
+    episodes_path = os.environ["EPISODES_JSON"]
+    output_dir = Path(os.environ["EPISODES_OUTPUT_DIR"])
+    start_idx = int(os.environ.get("EPISODES_START_IDX", "0"))
+    end_idx_env = os.environ.get("EPISODES_END_IDX", "")
+
+    output_dir.mkdir(parents=True, exist_ok=True)
+
+    with open(episodes_path) as f:
+        episodes = json.load(f)
+    end_idx = int(end_idx_env) if end_idx_env else len(episodes)
+    sliced = episodes[start_idx:end_idx]
+    print(f"[RF] running {len(sliced)} episodes from {episodes_path} [{start_idx}:{end_idx}]")
+
+    conf_dir = Path(calvin_conf_path)
+    task_cfg = OmegaConf.load(conf_dir / "callbacks/rollout/tasks/new_playtable_tasks.yaml")
+    task_oracle = hydra.utils.instantiate(task_cfg)
+
+    by_task = defaultdict(list)
+    for i, ep in enumerate(tqdm(sliced, position=0, leave=True)):
+        task_id = ep["task_id"]
+        success, n_steps, actions, eef_xyz = _rollout_episode_logged(
+            env, model, task_oracle, ep["init_state"], ep["lang_override"], task_id
+        )
+        record = {
+            "episode_idx": ep["episode_idx"],
+            "task_id": task_id,
+            "lang_override": ep["lang_override"],
+            "success": bool(success),
+            "num_steps": int(n_steps),
+            "actions": actions,
+            "eef_xyz": eef_xyz,
+            "metadata": ep["metadata"],
+        }
+        by_task[task_id].append(record)
+
+        # flush per-task JSON every 20 episodes (resilient to OOM/crash)
+        if (i + 1) % 20 == 0 or i == len(sliced) - 1:
+            for tid, recs in by_task.items():
+                out_path = output_dir / f"eval_{tid}__chunk{start_idx}_{end_idx}.json"
+                with open(out_path, "w") as f:
+                    json.dump({"task_id": tid, "episodes": recs}, f)
+
+    # final flush
+    for tid, recs in by_task.items():
+        out_path = output_dir / f"eval_{tid}__chunk{start_idx}_{end_idx}.json"
+        with open(out_path, "w") as f:
+            json.dump({"task_id": tid, "episodes": recs}, f)
+    print(f"[RF] wrote {sum(len(v) for v in by_task.values())} episodes -> {output_dir}")
+
+
+def eval_one_epoch_calvin_episodes(args, model, dataset_path, image_processor, tokenizer, future_act_len=-1):
+    """Entrypoint when EPISODES_JSON is set."""
+    env = make_env(dataset_path)
+    cast_dtype = get_cast_dtype(args.precision)
+    hist_len = None
+    if args.head_type == "diffusion":
+        hist_len = args.n_obs_steps
+    elif args.pad_length != -1:
+        hist_len = args.pad_length
+    wrapped_model = ModelWrapper(
+        model, tokenizer, image_processor, cast_dtype,
+        args.head_type == "diffusion", history_len=hist_len, future_act_len=future_act_len,
+    )
+    evaluate_policy_episodes(wrapped_model, env, args.calvin_conf_path)
